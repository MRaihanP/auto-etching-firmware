# Server
HOST=0.0.0.0
PORT=8080
COOKIE_SECURE=false
TRUST_PROXY=false
PUBLIC_ORIGIN=http://localhost:8080
DB_PATH=data/dashboard.db
WEB_DIST=../web/dist

# MQTT (hanya server yang melihat nilai ini)
MQTT_URL=mqtts://mqtt.loggerindonesia.com:8883
MQTT_USER=CHANGE_ME_MQTT_USER
MQTT_PASS=CHANGE_ME_MQTT_PASSWORD
MQTT_BASE=pelarut
# Kosongkan untuk auto-detect device dari topik status.
DEVICE_ID=
# Opsional: path CA PEM bila sistem tidak mempercayai chain broker.
MQTT_CA_PATH=

# OTA: server mengirim file ke IP alat port 3232 (jaringan lokal).
OTA_PORT=3232
OTA_PASS=CHANGE_ME_OTA_PASSWORD
OTA_MAX_MB=3
OTA_TIMEOUT_MS=30000

# Seed admin (dipakai `pnpm seed`, bukan runtime login)
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
